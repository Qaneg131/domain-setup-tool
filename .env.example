# Copy file này thành .env rồi điền key thật. KHÔNG commit .env lên git.
# Cloudflare: dash.cloudflare.com -> My Profile -> API Tokens -> Create Token
#   Template "Edit zone DNS" + thêm Zone:Zone:Edit, rồi chọn All zones (hoặc zone cụ thể)
CLOUDFLARE_API_TOKEN=
# Tuỳ chọn, lấy ở Cloudflare dashboard -> Account Home -> Account ID (cột phải)
CLOUDFLARE_ACCOUNT_ID=

# Namecheap: Profile -> Tools -> Namecheap API Access -> Enable
#   ApiUser = username Namecheap của bạn (thường trùng NAMECHEAP_USERNAME)
#   Whitelist IP: bật API xong phải add IP public của máy chạy tool vào whitelist, nếu không sẽ báo lỗi 1011107 / IP not whitelisted
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
# IP public của máy chạy tool. Để trống tool sẽ tự detect qua api.ipify.org
NAMECHEAP_CLIENT_IP=
# Test bằng sandbox thì đặt =1 (tài khoản sandbox khác tài khoản thật)
NAMECHEAP_SANDBOX=0
